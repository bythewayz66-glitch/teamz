[Unit]
Description=Teamz real agent endpoint (Pollinations-backed, for the 24/7 runner)
Documentation=https://github.com/bythewayz66-glitch/teamz
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=teamz
Group=teamz
WorkingDirectory=/opt/teamz-agent
# No secrets in this unit or the repo: the Pollinations API key lives in
# /etc/teamz-agent.env (root:root, 0600) on jnet1, loaded via the drop-in
# override /etc/systemd/system/teamz-agent.service.d/pollinations.conf
# (EnvironmentFile=/etc/teamz-agent.env). With the key set, the service
# switches to the keyed endpoint (gen.pollinations.ai) with no per-IP
# spacing, unlocking the full tool loop. Never commit the key.
ExecStart=/usr/bin/node /opt/teamz-agent/agent.mjs
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=8897
# 0.0.0.0: the Teamz UI on Jesse's phone fetches GET /runner-state on the
# tailnet address (jnet1 has no public IP). The runner still calls
# 127.0.0.1:8897/chat from the same host.
Environment=HOST=0.0.0.0
Environment=LOG_PATH=/var/log/teamz-agent/agent.log

[Install]
WantedBy=multi-user.target
